# Copy to backend/.env and edit. Never commit .env.
# MongoDB running on this PC (default):   mongodb://localhost:27017/wingo
# MongoDB Atlas (cloud):                  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/wingo
# In-memory (tests/demo, data lost on restart):  memory://
DATABASE_URL=mongodb://localhost:27017/wingo
# If set, every POST endpoint requires header  X-API-Key: <value>
ADMIN_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000
AUTO_SEED=true
AUTO_BACKTEST=true
SEED_CSV=data/wingo_transcribed.csv
MODEL_REFIT_EVERY=10
MIN_HISTORY=100
MIN_VALIDATION_N=300

# ---- Live sync (OFF by default) ---------------------------------------------------------------------------------
# Fill these in ONLY for a data source you are allowed to use (an official API, your own service, or a feed the operator
# permits). Nothing is guessed: with SYNC_SOURCE_URL empty, nothing is fetched. robots.txt is always read first.
SYNC_ENABLED=false
SYNC_INTERVAL_SECONDS=30
SYNC_SOURCE_URL=
# Where the list of rounds sits in the JSON, e.g. data.list  (empty = the JSON itself is the list)
SYNC_LIST_PATH=
SYNC_PERIOD_FIELD=
SYNC_NUMBER_FIELD=
SYNC_TIME_FIELD=
# Optional extra request headers as JSON, e.g. an access token the operator gave you
SYNC_HEADERS_JSON=
SYNC_RESPECT_ROBOTS=true
# Round ID of your NEWEST stored round. Needed once if your stored history has no round IDs.
SYNC_START_AFTER_PERIOD=
# false = stop at the first missing round (safe). true = store whatever the source returns.
SYNC_ALLOW_GAPS=false

# ---- Dashboard / operations ---------------------------------------------------------------------------------------
# How often the open dashboard checks for a new confirmed round (minimum 10). It only asks YOUR backend, never a website.
UI_POLL_SECONDS=30
# Sync is shown as "stale" when the last successful fetch is older than this
SYNC_STALE_AFTER_SECONDS=300
LOG_LEVEL=INFO
